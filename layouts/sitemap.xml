{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Data.Pages }}
    {{- if and (ne .Params.sitemap_exclude true) (ne .Draft true) (ne .Layout "search") (ne .RelPermalink "/search/") }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{- end }}
    {{- $changefreq := "" }}
    {{- if .Params.changefreq }}
      {{- $changefreq = .Params.changefreq }}
    {{- else if .IsHome }}
      {{- $changefreq = "daily" }}
    {{- else if or (eq .Section "blogs") (eq .Section "projects") }}
      {{- $changefreq = "weekly" }}
    {{- else if eq .RelPermalink "/site-map/" }}
      {{- $changefreq = "weekly" }}
    {{- else }}
      {{- $changefreq = "monthly" }}
    {{- end }}
    <changefreq>{{ $changefreq }}</changefreq>
    {{- $priority := "0.6" }}
    {{- if .Params.priority }}
      {{- $priority = .Params.priority }}
    {{- else if .IsHome }}
      {{- $priority = "1.0" }}
    {{- else if eq .Section "blogs" }}
      {{- if .IsPage }}
        {{- $priority = "0.9" }}
      {{- else }}
        {{- $priority = "0.8" }}
      {{- end }}
    {{- else if eq .Section "projects" }}
      {{- if .IsPage }}
        {{- $priority = "0.9" }}
      {{- else }}
        {{- $priority = "0.8" }}
      {{- end }}
    {{- else if or (eq .RelPermalink "/about/") (eq .RelPermalink "/contact/") }}
      {{- $priority = "0.8" }}
    {{- else if eq .RelPermalink "/site-map/" }}
      {{- $priority = "0.7" }}
    {{- else if or (eq .RelPermalink "/privacy-policy/") (eq .RelPermalink "/terms-and-conditions/") }}
      {{- $priority = "0.5" }}
    {{- else if or (eq .Kind "taxonomy") (eq .Kind "term") }}
      {{- $priority = "0.4" }}
    {{- end }}
    <priority>{{ $priority }}</priority>
  </url>
    {{- end }}
  {{- end }}
  <url>
    <loc>{{ "cast-in-Nepal/" | absURL }}</loc>
    <lastmod>{{ safeHTML ( now.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
